model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Suppliers", "Categories", "Pareto", "Savings", "Scenarios", "PriceGap", "Rules", "Quadrants", "TopFragmented"]

annotation PBI_ProTooling = ["DevMode"]

ref table Suppliers
ref table Categories
ref table Pareto
ref table Savings
ref table Scenarios
ref table PriceGap
ref table Rules
ref table Quadrants
ref table TopFragmented

ref cultureInfo en-US

