table Suppliers
	lineageTag: b048a681-feda-46fd-9413-8102c4d1d2dc

	measure 'Suppliers Today' = COUNTROWS(Suppliers)
		formatString: #,0
		lineageTag: c7b598e5-acd2-419a-b144-00a573a4f1bf

	measure 'Suppliers Kept' = CALCULATE(COUNTROWS(Suppliers), Suppliers[Decision] = "KEEP")
		formatString: #,0
		lineageTag: 61cef76b-3942-45ed-952e-292e5ac1f794

	measure 'Supplier Reduction %' = 1 - DIVIDE([Suppliers Kept], [Suppliers Today])
		formatString: 0.0%
		lineageTag: 94018f5b-0812-475e-8945-656441ada680

	measure 'Annual Spend ($M)' = DIVIDE(SUM(Suppliers[Spend per Year]), 1000000)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: c30f4015-f20e-4b4a-a879-5fcbe332ed22

	measure 'Spend Retained %' = DIVIDE(CALCULATE(SUM(Suppliers[Spend per Year]), Suppliers[Decision] = "KEEP"), SUM(Suppliers[Spend per Year]))
		formatString: 0.0%
		lineageTag: ac934a53-018e-4244-b5db-e59ba35c1d36

	measure 'Diverse Spend Retained %' = DIVIDE(CALCULATE(SUM(Suppliers[Spend per Year]), Suppliers[Small or Diverse] = "Yes", Suppliers[Decision] = "KEEP"), CALCULATE(SUM(Suppliers[Spend per Year]), Suppliers[Small or Diverse] = "Yes", Suppliers[Rule] <> "R4"))
		formatString: 0.0%
		lineageTag: eb65732c-a192-4aab-afe4-eda60dd538e8

	measure 'Re-routed Spend ($M)' = DIVIDE(CALCULATE(SUM(Suppliers[Spend per Year]), Suppliers[Rule] IN {"R5", "R8"}), 1000000)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 2a700834-d83b-4446-b697-363268d65271

