table Scenarios
	lineageTag: 9120d68d-c6fe-4334-9379-6659de25100b

	measure 'Base Run-rate ($M)' = CALCULATE(SUM(Scenarios[Run Rate $M]), Scenarios[Scenario] = "Base")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: cc365367-231b-42e9-8048-90203fac76bc

	measure 'Base Measured ($M)' = CALCULATE(SUM(Scenarios[Measured $M]), Scenarios[Scenario] = "Base")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: f889d8d8-bd64-4b1f-b539-98a8ca0aad14

	measure 'One-time Cost ($M)' = CALCULATE(SUM(Scenarios[One Time Cost $M]), Scenarios[Scenario] = "Base")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 59631f28-3cdb-45e5-8295-7ff392379fca

	measure 'Base NPV ($M)' = CALCULATE(SUM(Scenarios[NPV 3yr $M]), Scenarios[Scenario] = "Base")
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: b7456b79-5b4b-4c37-beb2-a83d3e7ea5b3

	measure 'Re-tender Needed %' = CALCULATE(MAX(Scenarios[Retender Needed]), Scenarios[Scenario] = "Base")
		formatString: 0.00%
		lineageTag: 1de13563-a635-4f6d-a3e2-039699e81013

